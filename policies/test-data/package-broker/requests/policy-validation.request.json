{
  "RequestKind": "PolicyValidationRequest",
  "RequestVersion": "1.0",
  "Draft": {
    "PolicyFormatVersion": "1.0.0",
    "Metadata": {
      "Id": "contoso.package-policy",
      "Publisher": "Contoso IT"
    },
    "Enforcement": {
      "DefaultDecision": "Allow",
      "AuditMode": true
    },
    "Rules": [
      {
        "Id": "allow.vscode.skip-hash",
        "Enabled": true,
        "Priority": 100,
        "Decision": "Allow",
        "Match": {
          "Managers": [
            "Winget"
          ],
          "PackageIdentifiers": {
            "Exact": [
              "Microsoft.VisualStudioCode"
            ]
          },
          "SkipHashCheck": true
        }
      }
    ],
    "EditorExtension": {
      "preserved": true
    }
  }
}
