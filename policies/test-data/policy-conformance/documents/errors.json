      "note": "An unknown top-level key '~1'; the key is the two characters '~1'; '~' becomes '~0' and '1' stays, giving '~01', not '~1' (RFC 6901 §3). Control: doc-minimal-valid.",
      "document": {"PolicyFormatVersion": "2.0.0", "Metadata": {"Id": "p", "Publisher": "x", "Revision": 1, "PublishedAt": "2026-01-01T00:00:00Z"}, "TrustedSources": [], "Rules": [], "~1": 1},
      "expect": {"errors": [{"code": "UnknownKey", "pointer": "/~01"}]}
    },
