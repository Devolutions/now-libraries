      "document": {"PolicyFormatVersion": "2.0.0", "Metadata": {"Id": "p", "Publisher": "x", "Revision": 1, "PublishedAt": "2026-01-01T00:00:00Z"}, "TrustedSources": [], "Rules": [], "": 1},
      "expect": {"errors": [{"code": "UnknownKey", "pointer": "/"}]}
    },
