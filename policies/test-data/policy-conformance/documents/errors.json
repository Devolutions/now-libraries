{
  "cases": [
    {
      "name": "doc-err-pointer-slash",
      "oracle": "contract policies/CONTRACT.policy.md §errors; RFC 6901 §3",
      "note": "An unknown top-level key 'a/b'; '/' is written '~1' (RFC 6901 §3). Control: doc-minimal-valid.",
      "document": {"PolicyFormatVersion": "2.0.0", "Metadata": {"Id": "p", "Publisher": "x", "Revision": 1, "PublishedAt": "2026-01-01T00:00:00Z"}, "TrustedSources": [], "Rules": [], "a/b": 1},
      "expect": {"errors": [{"code": "UnknownKey", "pointer": "/a~1b"}]}
    },
    {
      "name": "doc-err-pointer-tilde",
      "oracle": "contract policies/CONTRACT.policy.md §errors; RFC 6901 §3",
      "note": "An unknown top-level key 'a~b'; '~' is written '~0' (RFC 6901 §3). Control: doc-minimal-valid.",
      "document": {"PolicyFormatVersion": "2.0.0", "Metadata": {"Id": "p", "Publisher": "x", "Revision": 1, "PublishedAt": "2026-01-01T00:00:00Z"}, "TrustedSources": [], "Rules": [], "a~b": 1},
