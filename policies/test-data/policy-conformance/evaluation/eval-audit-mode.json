    {
      "name": "eval-audit-unreadable-request",
      "oracle": "contract policies/CONTRACT.policy.md §audit-mode",
      "note": "UnreadableRequest: Package.Id contains the batch character %, so the broker builds no WinGet command and the request is unreadable (§manager-winget). Audit mode does not let this check through.",
      "request": {
        "Operation": "Install",
        "Manager": "Winget",
        "Source": {"Name": "winget"},
        "Package": {"Id": "Contoso.Tool%", "Version": "1.2.3"},
        "Elevation": "NonElevated"
      },
      "expect": {"outcome": "Deny", "check": "UnreadableRequest", "rules": [], "optIns": [], "audited": false}
    },
    {
      "name": "eval-audit-validity-window",
